# Puerto y Entorno
PORT=3000
NODE_ENV=development

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=torneos_esports

# Seguridad y Autenticación
JWT_SECRET=super_secret_jwt_key_esports_2026
CORS_ORIGIN=http://localhost:3000

# Adaptadores Externos (Django Identity & Evidence)
# 'mock' para clon limpio y tests; 'http' para conectar con el servicio externo
EXTERNAL_ADAPTER_MODE=mock
DJANGO_SERVICE_URL=http://localhost:8000
DJANGO_SERVICE_TIMEOUT_MS=3000

# Ciclo de Vida del Proceso
SHUTDOWN_TIMEOUT_MS=10000
