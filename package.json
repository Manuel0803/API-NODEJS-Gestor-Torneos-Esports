{
  "name": "api-gestor-torneos-esports",
  "version": "0.1.0",
  "description": "Backend para gestión de torneos de videojuegos presenciales y en línea - TP Final Programación IV (UTN FRRe)",
  "type": "module",
  "main": "src/servidor.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/servidor.js",
    "start": "node src/servidor.js",
    "setup": "node --env-file=.env src/infra/db/setup.js",
    "test": "node --test --env-file=.env tests/**/*.test.js",
    "lint": "eslint ."
  },
  "keywords": [
    "esports",
    "tournaments",
    "express",
    "hexagonal-architecture",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "supertest": "^7.0.0"
  }
}
